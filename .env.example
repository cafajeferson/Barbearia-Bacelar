# Postgres — local (dev, nativo no Windows, sem Docker) OU Supabase a
# partir da Fase 10. Pro Supabase, use o POOLER (Supavisor), não a conexão
# direta — a direta só resolve em IPv6 e trava sem erro em redes sem rota
# IPv6 funcional. Pooler = Project Settings > Database > Connection
# Pooling, modo sessão (porta 5432, não a 6543 transaction).
# `?pgbouncer=true` NÃO é opcional: sem ele, sequências de operações
# Prisma (ex.: o seed) falham de forma não-determinística contra o
# Supavisor (prepared statements incompatíveis) — ver deploy/GUIA-DEPLOY.md.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barbearia_bacelar?schema=public"
# Supabase: DATABASE_URL="postgresql://postgres.SEU_REF:SENHA@SEU_POOLER_HOST:5432/postgres?pgbouncer=true"

# Papel não-superusuário para runtime da app (RLS se aplica a ele; acima é
# só p/ migrations). Local: criado uma vez via SQL fora do versionamento —
# ver README de setup local. Supabase: crie o role "app_user" manualmente
# via SQL Editor com as mesmas GRANTs da migration rls_and_overlap_guard —
# username no pooler precisa do ref sufixado: "app_user.SEU_REF".
APP_DATABASE_URL="postgresql://app_user:TROQUE_A_SENHA@localhost:5432/barbearia_bacelar?schema=public"
# Supabase: APP_DATABASE_URL="postgresql://app_user.SEU_REF:SENHA@SEU_POOLER_HOST:5432/postgres?pgbouncer=true"

# Supabase Auth (Fase 10) — Project Settings > API no painel do Supabase.
# NEXT_PUBLIC_* vão pro bundle do browser (são a chave pública, não
# segredo — formato novo sb_publishable_...); SUPABASE_SERVICE_ROLE_KEY é
# a chave secreta (sb_secret_...) — nunca prefixe com NEXT_PUBLIC_, nunca
# exponha ao client.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# WhatsApp via Evolution API self-hosted (Fase 10 — ver docker-compose.yml).
# Na VPS, use o nome do serviço na rede do compose, não localhost: os dois
# containers (app e evolution-api) não compartilham rede com o host.
EVOLUTION_API_URL="http://evolution-api:8080"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME="barbearia-bacelar"
# Senha do Postgres dedicado da Evolution API (container "evolution-db" no
# compose) — essa versão exige um banco de verdade pro próprio estado
# dela, sem relação nenhuma com o banco do app. Gere com `openssl rand -hex 24`.
EVOLUTION_DB_PASSWORD=""

# Segredo compartilhado que os endpoints /api/jobs/* exigem no header
# `x-jobs-secret` — é o que pg_cron usa pra chamar os jobs agendados sem
# expor um endpoint de automação totalmente aberto. Gere com
# `openssl rand -hex 32`.
JOBS_SECRET=""
