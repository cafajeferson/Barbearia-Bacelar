# Postgres — local (dev, nativo no Windows, sem Docker) OU o connection
# string do seu projeto Supabase (Project Settings > Database), a partir
# da Fase 10.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barbearia_bacelar?schema=public"

# Papel não-superusuário para runtime da app (RLS se aplica a ele; acima é
# só p/ migrations). Local: criado uma vez via SQL fora do versionamento —
# ver README de setup local. Supabase: crie o role "app_user" manualmente
# via SQL Editor com as mesmas GRANTs da migration rls_and_overlap_guard.
APP_DATABASE_URL="postgresql://app_user:TROQUE_A_SENHA@localhost:5432/barbearia_bacelar?schema=public"

# Supabase Auth (Fase 10) — Project Settings > API no painel do Supabase.
# NEXT_PUBLIC_* vão pro bundle do browser (são a chave pública "anon", não
# são segredo); SUPABASE_SERVICE_ROLE_KEY é secreta — nunca prefixe com
# NEXT_PUBLIC_, nunca exponha ao client.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# WhatsApp via Evolution API self-hosted (Fase 10 — ver docker-compose.yml)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME="barbearia-bacelar"

# Segredo compartilhado que os endpoints /api/jobs/* exigem no header
# `x-jobs-secret` — é o que pg_cron usa pra chamar os jobs agendados sem
# expor um endpoint de automação totalmente aberto. Gere com
# `openssl rand -hex 32`.
JOBS_SECRET=""
